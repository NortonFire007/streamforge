APP_ENV=development
APP_NAME=streamforge
LOG_LEVEL=INFO

# Docker Compose Profiles (cluster or single-broker)
COMPOSE_PROFILES=cluster

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamforge
POSTGRES_USER=streamforge
POSTGRES_PASSWORD=streamforge
# Optional: DATABASE_URL=postgresql+psycopg://streamforge:streamforge@localhost:5432/streamforge
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Message Broker (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=CVyl4Z3kSsutM_yEOpb5MQ

# Kafka Producer Settings
# Unique client identifier for logging/metrics
KAFKA_PRODUCER_CLIENT_ID=order-service
# Required acknowledgment level from brokers ('all' or '-1' required when idempotence is enabled)
KAFKA_PRODUCER_ACKS=all
# Exactly-once messaging per producer session (deduplication of retries on broker)
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
# Number of retry attempts on transient delivery failures
KAFKA_PRODUCER_RETRIES=5
# Time in milliseconds to buffer records before sending batch
KAFKA_PRODUCER_LINGER_MS=5
# Maximum time in milliseconds for end-to-end message delivery including retries
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=120000
# Compression codec for produced batches (none, gzip, snappy, lz4, zstd)
KAFKA_PRODUCER_COMPRESSION_TYPE=lz4

# Kafka Consumer Settings
# Unique client identifier for consumer instance
KAFKA_CONSUMER_CLIENT_ID=order-consumer
# Consumer group identifier for partitioned load balancing
KAFKA_CONSUMER_GROUP_ID=order-processing
# Initial offset position when no committed offset exists (earliest, latest, error)
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
# Note: enable.auto.commit is intentionally hardcoded to False in code as an immutable contract
# and MUST NOT be exposed or configured as an environment variable.
